# ─── GitHub OAuth App credentials ────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:       http://localhost:3000
# Callback URL:       http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Set by the app after OAuth — do not fill manually ───────────────────────
GITHUB_TOKEN=

# ─── Set by the app after repo connection — do not fill manually ──────────────
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ─── Cache settings ───────────────────────────────────────────────────────────
# Maximum size of data/cache/previews/ before LRU eviction kicks in
CACHE_MAX_PREVIEW_GB=2